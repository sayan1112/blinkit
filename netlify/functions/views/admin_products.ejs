<%- include('./partials/header'); %>

    <body class="bg-gray-100 font-sans">
        <div class="flex flex-col min-h-screen">
            <!-- Header -->
            <header class="bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
                    <div class="flex items-center gap-6">
                        <a href="/" class="flex items-center gap-1">
                            <span class="text-2xl font-black text-blinkit-yellow">blink</span>
                            <span class="text-2xl font-black text-blinkit-green">it</span>
                        </a>
                        <h1 class="text-lg font-bold text-gray-900 border-l border-gray-200 pl-4">Product Inventory</h1>
                    </div>

                    <div class="flex items-center gap-3">
                        <a href="/admin/dashboard" class="text-sm font-semibold text-gray-700 hover:text-black px-3 py-1.5 rounded-lg hover:bg-gray-100 transition">
                            <i class="ri-dashboard-line mr-1"></i> Dashboard
                        </a>
                        <a href="/admin/orders" class="text-sm font-semibold text-gray-700 hover:text-black px-3 py-1.5 rounded-lg hover:bg-gray-100 transition">
                            <i class="ri-file-list-3-line mr-1"></i> Orders
                        </a>
                        <a href="/admin/dashboard" class="text-xs font-bold bg-blinkit-green hover:bg-blinkit-darkgreen text-white px-3.5 py-2 rounded-lg transition shadow-sm">
                            + Add Product
                        </a>
                        <a href="/admin/logout" class="text-xs font-bold text-red-600 bg-red-50 hover:bg-red-100 px-3 py-2 rounded-lg transition">
                            Logout
                        </a>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 overflow-y-auto py-8">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- Search Bar -->
                    <div class="mb-8">
                        <form action="/admin/products/search" method="GET" class="flex max-w-lg shadow-sm">
                            <div class="relative flex-1">
                                <i class="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                <input type="text" name="product_id" placeholder="Search by Product Name or MongoDB ID..."
                                    class="w-full pl-10 p-3 bg-white border border-gray-300 rounded-l-xl focus:ring-2 focus:ring-black outline-none text-sm">
                            </div>
                            <button type="submit"
                                class="bg-gray-900 hover:bg-black text-white text-xs font-bold py-3 px-6 rounded-r-xl transition">
                                Search
                            </button>
                        </form>
                    </div>

                    <!-- Empty state -->
                    <% if(Object.keys(products).length === 0){ %>
                        <div class="bg-white p-12 rounded-2xl shadow-sm text-center border border-gray-100">
                            <i class="ri-search-eye-line text-4xl text-gray-400 mb-3 block"></i>
                            <h3 class="text-lg font-bold text-gray-800">No products found</h3>
                            <p class="text-xs text-gray-500 mt-1 mb-4">Try clearing the search or adding new products.</p>
                            <a href="/admin/products" class="text-xs font-bold text-blinkit-green underline">Reset Search</a>
                        </div>
                    <% } %>

                    <!-- Product List by Category -->
                    <% for(let key in products){ %>
                        <div class="bg-white shadow-sm rounded-2xl mb-8 p-6 border border-gray-100">
                            <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-6">
                                <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                                    <span class="w-2.5 h-6 bg-blinkit-green rounded-full"></span>
                                    <%= key %>
                                </h2>
                                <span class="text-xs font-bold text-gray-400 bg-gray-50 px-2.5 py-1 rounded-full">
                                    <%= products[key].length %> item<%= products[key].length > 1 ? 's' : '' %>
                                </span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                                <% products[key].forEach(function(elem){ %>
                                    <div class="bg-gray-50 p-4 rounded-xl border border-gray-200/80 hover:shadow-md transition flex flex-col justify-between">
                                        <div>
                                            <div class="w-full h-36 bg-white rounded-lg p-2 mb-3 flex items-center justify-center">
                                                <img class="max-h-full max-w-full object-contain"
                                                    src="data:image/jpeg;base64, <%= elem.image.toString('base64') %>" alt="<%= elem.name %>">
                                            </div>
                                            <h3 class="text-sm font-bold text-gray-900 line-clamp-2">
                                                <%= elem.name %>
                                            </h3>
                                            <div class="flex items-center justify-between mt-2 text-xs">
                                                <span class="font-bold text-gray-900 text-sm">₹<%= elem.price %></span>
                                                <span class="font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Stock: <%= elem.stock %></span>
                                            </div>
                                            <p class="mt-2 text-xs text-gray-500 line-clamp-2">
                                                <%= elem.description %>
                                            </p>
                                        </div>

                                        <div class="mt-4 pt-3 border-t border-gray-200 text-xs flex items-center justify-between">
                                            <span class="text-[10px] text-gray-400 truncate max-w-[120px]" title="<%= elem._id %>">ID: <%= elem._id.toString().slice(-6) %></span>
                                            <div class="flex gap-3">
                                                <a href="/products/edit/<%= elem._id %>" class="font-bold text-blue-600 hover:text-blue-800 transition">
                                                    Edit
                                                </a>
                                                <a href="/products/delete/<%= elem._id %>" onclick="return confirm('Are you sure you want to delete this product?')"
                                                    class="font-bold text-red-600 hover:text-red-800 transition">
                                                    Delete
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                </div>
            </main>
        </div>
    </body>

<%- include('./partials/footer'); %>
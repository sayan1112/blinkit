<%- include('./partials/header'); %>

<body class="bg-gray-100 font-sans">
    <div class="max-w-2xl mx-auto p-4 py-10">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Edit Product</h1>
                    <p class="text-xs text-gray-500 mt-1">ID: <%= product._id %></p>
                </div>
                <a href="/admin/products" class="text-xs font-bold text-gray-600 hover:text-black">
                    ← Back to Products
                </a>
            </div>

            <form action="/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Product Name</label>
                    <input type="text" name="name" value="<%= product.name %>" required
                        class="w-full p-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-black outline-none">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Price (₹)</label>
                        <input type="number" name="price" value="<%= product.price %>" required min="1"
                            class="w-full p-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-black outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Stock Quantity</label>
                        <input type="number" name="stock" value="<%= product.stock %>" required min="0"
                            class="w-full p-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-black outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Category</label>
                    <input type="text" name="category" value="<%= product.category %>" required
                        class="w-full p-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-black outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Description</label>
                    <textarea name="description" rows="3"
                        class="w-full p-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-black outline-none"><%= product.description %></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Replace Image (Optional)</label>
                    <input type="file" name="image" accept="image/*"
                        class="w-full p-2 text-sm border border-gray-300 rounded-xl bg-gray-50 file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-black">
                </div>

                <div class="flex items-center gap-3 pt-4">
                    <button type="submit"
                        class="flex-1 py-3 bg-blinkit-green hover:bg-blinkit-darkgreen text-white font-bold text-sm rounded-xl transition shadow-md">
                        Save Changes
                    </button>
                    <a href="/admin/products"
                        class="py-3 px-6 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm rounded-xl transition text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
<%- include('./partials/footer'); %>

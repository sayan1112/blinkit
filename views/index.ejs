<%- include('./partials/header'); %>

    <style>
        .swiper-container {
            width: 100%;
            max-width: 900px;
        }

        .swiper-slide {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 92%;
            height: 220px;
            background-color: #f0f0f0;
            border-radius: 16px;
            overflow: hidden;
        }
    </style>

    <body class="bg-gray-100 font-sans pb-24">
        <!-- Blinkit Signature Sticky Top Navbar -->
        <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
            <div class="max-w-screen-xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
                <!-- Brand Logo -->
                <div class="flex items-center gap-6">
                    <a href="/" class="flex items-center gap-1 group">
                        <span class="text-3xl font-black text-blinkit-yellow tracking-tight">blink</span>
                        <span class="text-3xl font-black text-blinkit-green tracking-tight">it</span>
                    </a>

                    <!-- Delivery in 8 Mins & Location -->
                    <div class="hidden md:flex flex-col border-l border-gray-200 pl-4 text-left">
                        <div class="flex items-center gap-1 font-extrabold text-sm text-gray-900 leading-tight">
                            <span>Delivery in 8 minutes</span>
                            <i class="ri-flashlight-fill text-blinkit-yellow text-base"></i>
                        </div>
                        <div class="flex items-center gap-1 text-xs text-gray-500 font-medium">
                            <span class="truncate max-w-[200px]">Sector 22, DLF Phase 2, Gurugram</span>
                            <i class="ri-arrow-down-s-line text-gray-600"></i>
                        </div>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="flex-1 max-w-xl">
                    <form action="/search" method="GET" class="relative">
                        <i class="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
                        <input type="text" name="q" id="searchInput"
                            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                            placeholder="Search 'milk', 'chips', 'bread', 'coke'..."
                            class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blinkit-green focus:border-transparent transition" />
                    </form>
                </div>

                <!-- Right Action Buttons -->
                <div class="flex items-center gap-3">
                    <% if(user){ %>
                        <div class="relative group">
                            <button class="flex items-center gap-2 py-2 px-3 rounded-lg hover:bg-gray-100 font-medium text-sm text-gray-800">
                                <i class="ri-user-smile-line text-lg text-blinkit-green"></i>
                                <span class="hidden sm:inline"><%= user.name %></span>
                                <i class="ri-arrow-down-s-line text-xs"></i>
                            </button>
                            <div class="absolute right-0 mt-1 w-48 bg-white border border-gray-200 rounded-xl shadow-lg py-2 hidden group-hover:block z-50">
                                <a href="/order/history/all" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"><i class="ri-file-list-3-line mr-2"></i>My Orders</a>
                                <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-50"><i class="ri-logout-box-r-line mr-2"></i>Logout</a>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="text-sm font-semibold text-gray-800 hover:text-blinkit-green px-3 py-2">
                            Login
                        </a>
                    <% } %>

                    <!-- Admin Portal Link -->
                    <a href="/admin" class="hidden sm:flex items-center gap-1.5 text-xs font-semibold bg-gray-900 text-white px-3 py-2 rounded-lg hover:bg-black transition">
                        <i class="ri-dashboard-line"></i>
                        <span>Admin</span>
                    </a>

                    <!-- Cart Button in Header -->
                    <a href="/cart" class="flex items-center gap-2 bg-blinkit-green hover:bg-blinkit-darkgreen text-white font-bold text-sm px-4 py-2.5 rounded-xl transition shadow-sm">
                        <i class="ri-shopping-cart-2-line text-lg"></i>
                        <span><%= cartCount > 0 ? `${cartCount} items` : 'My Cart' %></span>
                    </a>
                </div>
            </div>
        </header>

        <div class="max-w-screen-lg mx-auto p-4 mt-2">
            <!-- Order Now Section -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-6 border border-gray-100">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex items-center gap-2">
                        <h2 class="text-lg font-bold text-gray-900">Order Now</h2>
                        <span class="bg-amber-100 text-amber-800 text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">Fast Delivery</span>
                    </div>
                    <a href="#all-products" class="text-sm font-semibold text-blinkit-green hover:underline">see all</a>
                </div>
                <div class="flex space-x-4 mt-3 overflow-x-auto pb-2 scrollbar-thin">
                    <% rnproducts.forEach(function(elem){ %>
                        <div class="flex w-36 flex-shrink-0 flex-col items-center bg-gray-50/70 p-3 rounded-xl border border-gray-100 hover:shadow-md transition">
                            <div class="relative w-full h-24 flex items-center justify-center bg-white rounded-lg p-1">
                                <img src="data:image/jpeg;base64, <%= elem.image.toString('base64') %>"
                                    alt="<%= elem.name %>" class="max-h-full max-w-full object-contain rounded">
                            </div>
                            <p class="text-xs font-medium text-gray-800 text-center mt-2 line-clamp-2 h-8">
                                <%= elem.name %>
                            </p>
                            <div class="flex items-center gap-2 mt-1">
                                <p class="text-xs text-gray-400 line-through">₹<%= Number(elem.price)+20 %></p>
                                <p class="font-bold text-sm text-gray-900">₹<%= elem.price %></p>
                            </div>
                            <a href="/cart/add/<%= elem._id %>" class="w-full text-center bg-blinkit-green hover:bg-blinkit-darkgreen text-white text-xs font-bold py-1.5 rounded-lg mt-2 shadow-sm transition active:scale-95">
                                ADD
                            </a>
                        </div>
                    <%}) %>
                </div>
            </div>

            <!-- Offers Section (Swiper) -->
            <div class="swiper-container my-6 w-full overflow-hidden">
                <div class="swiper-wrapper">
                    <div class="swiper-slide rounded-xl overflow-hidden shadow-sm">
                        <img class="w-full h-full object-cover"
                            src="https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=70,metadata=none,w=720/layout-engine/2023-07/pharmacy-WEB.jpg"
                            alt="Pharmacy Deals">
                    </div>
                    <div class="swiper-slide rounded-xl overflow-hidden shadow-sm">
                        <img class="w-full h-full object-cover"
                            src="https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=70,metadata=none,w=720/layout-engine/2023-07/Pet-Care_WEB.jpg"
                            alt="Pet Care Deals">
                    </div>
                    <div class="swiper-slide rounded-xl overflow-hidden shadow-sm">
                        <img class="w-full h-full object-cover"
                            src="https://images.unsplash.com/photo-1542838132-92c53300491e?w=800&q=80"
                            alt="Fresh Groceries">
                    </div>
                </div>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 no-scrollbar">
                <a href="/" class="px-4 py-2 bg-gray-900 text-white rounded-full text-xs font-semibold whitespace-nowrap">All Items</a>
                <% for(let key in products){ %>
                    <a href="#cat-<%= key.replace(/\s+/g, '-') %>" class="px-4 py-2 bg-white border border-gray-200 text-gray-700 hover:border-blinkit-green hover:text-blinkit-green rounded-full text-xs font-semibold whitespace-nowrap shadow-sm transition">
                        <%= key %>
                    </a>
                <% } %>
            </div>

            <!-- Grocery & Kitchen Section by Categories -->
            <div id="all-products">
                <% for(let key in products){ %>
                    <div id="cat-<%= key.replace(/\s+/g, '-') %>" class="bg-white p-5 rounded-xl shadow-sm mb-6 border border-gray-100">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4">
                            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                                <span class="w-2 h-5 bg-blinkit-green rounded-full"></span>
                                <%= key %>
                            </h2>
                            <span class="text-xs text-gray-400 font-medium"><%= products[key].length %> products</span>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                            <% products[key].forEach(elem=>{ %>
                                <div class="flex flex-col items-center bg-gray-50/60 p-3 rounded-xl border border-gray-100 hover:shadow-md transition">
                                    <div class="w-full h-28 flex items-center justify-center bg-white rounded-lg p-2">
                                        <img src="data:image/jpeg;base64, <%= elem.image.toString('base64') %>"
                                            alt="<%= elem.name %>" class="max-h-full max-w-full object-contain rounded">
                                    </div>
                                    <p class="text-xs font-semibold text-gray-800 text-center mt-2.5 line-clamp-2 h-8">
                                        <%= elem.name %>
                                    </p>
                                    <p class="text-xs font-bold text-gray-900 mt-1">₹<%= elem.price %></p>
                                    <a class="w-full text-center px-4 text-white text-xs font-bold rounded-lg mt-2.5 py-1.5 bg-blinkit-green hover:bg-blinkit-darkgreen transition active:scale-95 shadow-sm"
                                        href="/cart/add/<%= elem._id %>">ADD</a>
                                </div>
                            <%}) %>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Sticky Bottom Cart Bar -->
            <% if(somethingInCart){ %>
                <div class="fixed bottom-4 inset-x-0 z-40 max-w-lg mx-auto px-4">
                    <div class="bg-gray-900 text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between border border-gray-800">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blinkit-green flex items-center justify-center text-white font-bold text-base">
                                <%= cartCount %>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-white"><%= cartCount %> Item<%= cartCount > 1 ? 's' : '' %> added</p>
                                <p class="text-[11px] text-gray-300">Extra discounts applied</p>
                            </div>
                        </div>
                        <a href="/cart"
                            class="flex items-center gap-1.5 px-6 py-2.5 bg-blinkit-green hover:bg-blinkit-darkgreen text-white font-bold text-sm rounded-xl transition shadow-lg active:scale-95">
                            <span>View Cart</span>
                            <i class="ri-arrow-right-line text-lg"></i>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>

        <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
        <script>
            var swiper = new Swiper('.swiper-container', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 8,
                    stretch: 0,
                    depth: 30,
                    modifier: 1,
                    slideShadows: false,
                },
                loop: true,
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                },
            });
        </script>
        <script>
            // Save the scroll position to localStorage
            window.addEventListener('scroll', function () {
                localStorage.setItem('scrollPosition', window.scrollY);
            });

            // Restore the scroll position from localStorage
            window.addEventListener('load', function () {
                const scrollPosition = localStorage.getItem('scrollPosition');
                if (scrollPosition) {
                    window.scrollTo(0, scrollPosition);
                }
            });
        </script>
    </body>
    <%- include('./partials/footer'); %>